{
  "name": "elven-hunter-3d",
  "version": "0.7.0",
  "description": "An open-world, third-person low-poly forest game that runs in a single self-contained HTML file. No engine, no dependencies, no network at runtime.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node tools/build.mjs && node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node tools/build.mjs && node test/run.mjs"
  },
  "keywords": ["webgl", "game", "low-poly", "no-dependencies", "canvas"],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "playwright": "^1.47.0"
  },
  "engines": { "node": ">=18" }
}
