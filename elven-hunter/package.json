{
  "name": "elven-hunter-3d",
  "version": "0.7.0",
  "description": "An open-world, third-person low-poly forest game that runs in a single self-contained HTML file. Rendered with three.js, bundled inline; no network at runtime.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "models": "node tools/models.mjs",
    "start": "node tools/build.mjs && node tools/serve.mjs",
    "serve": "node tools/serve.mjs",
    "test": "node tools/build.mjs && node test/run.mjs"
  },
  "keywords": [
    "webgl",
    "game",
    "low-poly",
    "three.js",
    "single-file",
    "canvas"
  ],
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "three": "0.187.0"
  },
  "engines": {
    "node": ">=18"
  }
}
